NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
# dev only: show "Simulate capture" on rider timelines (never enable in production)
# NEXT_PUBLIC_ENABLE_MOCK_CAPTURE="1"

# Fleet map: GPS position of the hub / warehouse. Vehicle positions are drawn relative to it.
# If unset, the map centres on the median of all reported vehicle positions.
# NEXT_PUBLIC_HUB_LAT="18.5204"
# NEXT_PUBLIC_HUB_LNG="73.8567"

# Where the Rider App is served (used by the "Open Rider App" links).
# NEXT_PUBLIC_RIDER_APP_URL="http://localhost:5173/rider.html"

# Google Maps JavaScript API key for the fleet map (HTTP-referrer-restricted
# web key from Google Cloud Console → APIs & Services → Credentials).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
